//70. Climbing Stairs II // Java
class Solution {
    public int climbStairs(int n) {
        if(n <= 2) return n;

        int pre1 = 2, pre2 = 1;
        for(int i = 3; i <=n; i++){
            int cur = pre1 + pre2;
            pre2 = pre1;
            pre1 = cur;
        }
        return pre1;
    }
}


//3693. Climbing Stairs II
// Python 
class Solution:
    def climbStairs(self, n: int, costs: list[int]) -> int:
        dp = [0] + [float('inf')] * n   # dp[0] = 0, start for free

        for j in range(1, n + 1):
            for k in (1, 2, 3):
                if j - k >= 0:
                    # costs is 1-indexed in the problem, so step j is costs[j-1]
                    dp[j] = min(dp[j], dp[j - k] + costs[j - 1] + k * k)

        return dp[n]
